        <mxCell id="p7e6" edge="1" parent="1" source="p7n7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;dashed=1;endArrow=none;fontStyle=1;" target="p7n4" value="encrypts stream and objects">
