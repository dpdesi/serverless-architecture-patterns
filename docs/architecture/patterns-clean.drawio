        </mxCell>
        <mxCell id="p4e8" edge="1" parent="1" source="p4n7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#C7131F;strokeColor=#C7131F;dashed=1;jettySize=auto;fontStyle=1;" target="p4n8" value="F2. poison messages to egress DLQ">
