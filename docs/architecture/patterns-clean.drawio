  <diagram name="Example: Online Order Subsystem" id="example-online-order">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1740" pageHeight="1360" math="0" shadow="0">
