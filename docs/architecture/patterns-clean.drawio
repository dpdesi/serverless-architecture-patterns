        <mxCell id="p12e5" edge="1" parent="1" source="p12n5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;fontStyle=1;" target="p12n6" value="email">
