        </mxCell>
        <mxCell id="p10e4" edge="1" parent="1" source="p10n2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;jettySize=auto;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;strokeColor=#545B64;" target="p10n5" value="3. /api/* (cache disabled, host stripped)">
