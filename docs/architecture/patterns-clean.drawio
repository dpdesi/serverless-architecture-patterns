        <mxCell id="p13e2" edge="1" parent="1" source="p13n2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;fontStyle=1;" target="p13n4" value="upload mfe.json">
