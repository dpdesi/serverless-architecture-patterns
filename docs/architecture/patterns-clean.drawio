          <mxGeometry height="14" width="40" x="1189" y="129" as="geometry" />
        </mxCell>
        <mxCell id="tg_esg_t1" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#D05C17;gradientColor=#F78E04;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" value="" vertex="1">
