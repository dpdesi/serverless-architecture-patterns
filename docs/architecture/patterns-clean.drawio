        <mxCell id="ob_e13" edge="1" parent="1" source="ob_obs_body" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontStyle=1;jettySize=auto;fontColor=#232F3E;strokeColor=#545B64;dashed=1;" target="ob_health_body" value="alarm fan-out">
