          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13e6" edge="1" parent="1" source="p13n5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;dashed=1;fontStyle=1;" target="p13n6" value="CreateInvalidation (optional, ARN-scoped)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13e7" edge="1" parent="1" source="p13n7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;fontStyle=1;" target="p13n6" value="serve master manifests">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p13desc" parent="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FAFBFC;strokeColor=#D5DBDB;fontColor=#2B3A42;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=0;fontFamily=Segoe UI;arcSize=4;gradientColor=#E6E6E6;gradientDirection=north;" value="&lt;b&gt;Intent&lt;/b&gt; - Independent deployment of micro applications without coordinated releases.&lt;br&gt;&lt;b&gt;Flow&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Each micro-app CI/CD uploads its mfe.json fragment to the manifests/ prefix.&lt;/li&gt;&lt;li&gt;The S3 notification (filtered to that prefix and .json suffix, so master writes cannot re-trigger it) drives the deployer Lambda.&lt;/li&gt;&lt;li&gt;The deployer merges every fragment into the master importmap, apps and mount-points manifests.&lt;/li&gt;&lt;li&gt;CloudFront serves the masters after an optional ARN-scoped invalidation.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Boundary&lt;/b&gt; - The deployer owns aggregation; micro-app teams own their own fragments and pipeline cadence. The deployer code arrives as an S3 artefact, so the module stays source-code free." vertex="1">
          <mxGeometry height="260" width="1320" x="40" y="745" as="geometry" />
        </mxCell>
