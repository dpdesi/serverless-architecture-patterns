        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ob_title" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;whiteSpace=wrap;" value="Worked example: Online order subsystem - each component is one pattern glyph (see the Pattern Icons key). Numbered labels show the execution path." vertex="1">
          <mxGeometry height="30" width="1300" x="40" y="20" as="geometry" />
