        <mxCell id="p12e4" edge="1" parent="1" source="p12n2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;fontStyle=1;" target="p12n5" value="notify target">
          <mxGeometry relative="1" as="geometry" />
