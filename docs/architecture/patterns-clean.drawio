        <mxCell id="p5e6" edge="1" parent="1" source="p5n6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;fontStyle=1" target="p5n7" value="4. collect / correlate state">
