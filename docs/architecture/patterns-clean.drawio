        <mxCell id="po_c10" edge="1" parent="1" source="po_bank" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;jettySize=auto;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;strokeColor=#545B64;" target="po_gw_body" value="10. settlement / return webhook">
