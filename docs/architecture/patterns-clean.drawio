        <mxCell id="Guidance" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F7F8FA;strokeColor=#B3BAC5;fontColor=#172B4D;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Pattern description&lt;/b&gt;&lt;br&gt;&lt;b&gt;Intent:&lt;/b&gt; A regional readiness signal for failover decisions.&lt;br&gt;&lt;b&gt;Flow:&lt;/b&gt; Per-service CloudWatch metric alarms wrap each AWS dependency the subsystem relies on; a Route 53 calculated health check aggregates them so DNS failover trips only when the region as a whole is unhealthy; a composite CloudWatch alarm fans the same signal to on-call.&lt;br&gt;&lt;b&gt;Boundary:&lt;/b&gt; The check represents subsystem readiness rather than only raw endpoint uptime. A CloudWatch Synthetics canary in the opposite region is the recommended traffic source but lives outside this module." vertex="1">
          <mxGeometry height="115" width="1240" x="80" y="795" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
