        <mxCell id="p5e5" edge="1" parent="1" source="p5n4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#C7131F;strokeColor=#C7131F;dashed=1;jettySize=auto;fontStyle=1;" target="p5n5" value="F2. poison messages to listener DLQ">
