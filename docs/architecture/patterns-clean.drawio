          </mxGeometry>
        </mxCell>
        <mxCell id="p10e5" edge="1" parent="1" source="p10n6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;jettySize=auto;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;strokeColor=#545B64;dashed=1;endArrow=none;" target="p10n2" value="viewer certificate">
