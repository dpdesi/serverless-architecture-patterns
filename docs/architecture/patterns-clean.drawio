        <mxCell id="p6e7" edge="1" parent="1" source="p6n5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;fontStyle=1;" target="p6n8" value="3. orchestrate (waits, retries, compensation)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6e8" edge="1" parent="1" source="p6n5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;fontStyle=1;" target="p6n1" value="4. PutEvents (result events)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="754" y="60" />
              <mxPoint x="114" y="60" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p6desc" parent="1" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FAFBFC;strokeColor=#D5DBDB;fontColor=#2B3A42;align=left;verticalAlign=top;spacing=14;fontSize=13;fontStyle=0;fontFamily=Segoe UI;arcSize=4;gradientColor=#E6E6E6;gradientDirection=north;" value="&lt;b&gt;Intent&lt;/b&gt; - A control service for explicit orchestration, waits, compensation and approvals.&lt;br&gt;&lt;b&gt;Flow&lt;/b&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; The hub delivers events matching the workflow rule.&lt;/li&gt;&lt;li&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; The rule starts the state machine through the dedicated events_start_execution role.&lt;/li&gt;&lt;li&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; The workflow orchestrates downstream services with waits, retries and compensation, logging to CloudWatch and tracing to X-Ray as it runs.&lt;/li&gt;&lt;li&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; PutEvents states in the workflow definition publish result events back to the hub.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Failure paths&lt;/b&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;F1&lt;/b&gt;&amp;nbsp; Starts EventBridge cannot complete dead-letter to the rule-target DLQ instead of being dropped.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Note&lt;/b&gt; - The module ships a placeholder pass-through definition; supply a real ASL definition for production.&lt;br&gt;&lt;b&gt;Boundary&lt;/b&gt; - The workflow coordinates process state without turning downstream services into shared libraries." vertex="1">
          <mxGeometry height="260" width="1320" x="40" y="745" as="geometry" />
        </mxCell>
        <mxCell id="tg_control_s_body" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F3F4;strokeColor=#C9CDD1;" value="" vertex="1">
          <mxGeometry height="94" width="104" x="1256" y="60" as="geometry" />
        </mxCell>
        <mxCell id="tg_control_s_tab" parent="1" style="rounded=0;fillColor=#7F868E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="Control (saga)" vertex="1">
