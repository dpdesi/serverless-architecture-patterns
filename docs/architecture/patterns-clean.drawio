        <mxCell id="e_hub_fm" edge="1" parent="1" source="ex_hub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6B778C;endArrow=block;endFill=1;dashed=1;exitX=0.78;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="ex_fm" value="faults">
