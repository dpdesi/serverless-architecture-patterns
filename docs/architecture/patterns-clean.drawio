          <mxGeometry height="94" width="142" x="1218" y="60" as="geometry" />
        </mxCell>
        <mxCell id="tg_microfe_tab" parent="1" style="rounded=0;fillColor=#7F868E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="Micro Frontend" vertex="1">
