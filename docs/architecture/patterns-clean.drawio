        <mxCell id="RHC_E5" edge="1" parent="1" source="RHC_5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6B778C;endArrow=block;endFill=1;dashed=1;jumpStyle=none;" target="RHC_6" value="notify">
