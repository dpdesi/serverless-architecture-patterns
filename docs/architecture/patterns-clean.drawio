        <mxCell id="p4e9" edge="1" parent="1" source="p4n9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#232F3E;strokeColor=#545B64;jettySize=auto;fontStyle=1;" target="p4n1" value="7. call external API">
