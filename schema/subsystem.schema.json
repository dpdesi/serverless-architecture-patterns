{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/serverless-architecture-patterns/schema/subsystem.schema.json",
  "title": "Autonomous subsystem manifest",
  "description": "Declarative description of an autonomous serverless subsystem composed from the pattern library. One manifest renders to one Terraform root via modules/composition/subsystem. The vocabulary matches the pattern glyphs in docs/architecture/patterns-clean.drawio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subsystem",
    "tags"
  ],
  "properties": {
    "subsystem": {
      "type": "string",
      "description": "Subsystem name. Used as the prefix for every resource name, so keep it short.",
      "pattern": "^[a-z][a-z0-9-]{1,23}$"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "object",
      "description": "Propagated to every resource. Environment, System and Owner are mandatory across the library.",
      "required": [
        "Environment",
        "System",
        "Owner"
      ],
      "properties": {
        "Environment": {
          "type": "string"
        },
        "System": {
          "type": "string"
        },
        "Owner": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "artefact_defaults": {
      "type": "object",
      "description": "Default S3 location for Lambda artefacts. Per-component keys default to <prefix><subsystem>-<service>-<component>.zip; any component can override with an explicit artefact.",
      "additionalProperties": false,
      "required": [
        "bucket"
      ],
      "properties": {
        "bucket": {
          "type": "string"
        },
        "prefix": {
          "type": "string",
          "default": ""
        }
      }
    },
    "hub": {
      "type": "object",
      "description": "Event hub settings [event_hub]. The hub itself is always created.",
      "additionalProperties": false,
      "properties": {
        "archive": {
          "type": "boolean",
          "default": true
        },
        "archive_retention_days": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      }
    },
    "bffs": {
      "type": "array",
      "description": "Backend-for-Frontend services [bff_service]. One per user activity.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,23}$"
          },
          "activity": {
            "type": "string",
            "description": "The kind of user activity, from the book's BFF taxonomy. Documentation only.",
            "enum": [
              "crud",
              "lov",
              "task",
              "search",
              "action",
              "dashboard",
              "reporting",
              "archive"
            ]
          },
          "path": {
            "type": "string",
            "description": "CloudFront path pattern, e.g. /payouts/*. Surfaced via the composer's api_origins output (regardless of edge.enabled) for a separate us-east-1 edge root to mount behind CloudFront.",
            "pattern": "^/[a-z0-9-]+/\\*$"
          },
          "read_only": {
            "type": "boolean",
            "default": false,
            "description": "Documentation only: the view is materialised from subscribed events (CQRS)."
          },
          "subscribes": {
            "type": "array",
            "description": "Event detail-types routed from the hub into this BFF's listener queue.",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "publishes": {
            "type": "array",
            "description": "Event detail-types this BFF emits. Documentation only - publication is database-first via the stream trigger.",
            "items": {
              "type": "string"
            }
          },
          "jwt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuer",
              "audiences"
            ],
            "properties": {
              "issuer": {
                "type": "string"
              },
              "audiences": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          },
          "cors_allow_origins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "table": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hash_key": {
                "type": "string",
                "default": "pk"
              },
              "range_key": {
                "type": "string",
                "default": "sk"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "S",
                        "N",
                        "B"
                      ]
                    }
                  }
                }
              }
            }
          },
          "artefacts": {
            "$ref": "#/$defs/bffArtefacts"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "description": "Control services [control_service]. Reactors derive higher-order events; sagas orchestrate.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "mode",
          "subscribes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,23}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "event_reactor",
              "step_functions"
            ]
          },
          "subscribes": {
            "type": "array",
            "description": "Event detail-types that trigger this control service.",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "emits": {
            "type": "array",
            "description": "Event detail-types this service publishes back to the hub. Documentation only.",
            "items": {
              "type": "string"
            }
          },
          "artefacts": {
            "type": "object",
            "description": "Required in event_reactor mode unless artefact_defaults is set.",
            "additionalProperties": false,
            "properties": {
              "listener": {
                "$ref": "#/$defs/artefact"
              },
              "trigger": {
                "$ref": "#/$defs/artefact"
              }
            }
          },
          "state_machine_definition": {
            "type": "object",
            "description": "step_functions mode: the Amazon States Language definition, inline as YAML (jsonencoded by the composer). Without it the module's placeholder pass-through definition is used - not production-ready.",
            "required": [
              "StartAt",
              "States"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "step_functions"
                }
              }
            },
            "then": {
              "properties": {
                "artefacts": false
              }
            }
          }
        ]
      }
    },
    "esgs": {
      "type": "array",
      "description": "External Service Gateways [esg_service]. Anti-corruption boundaries around external systems.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,23}$"
          },
          "external": {
            "type": "string",
            "description": "The external system this gateway isolates. Documentation only."
          },
          "egress": {
            "type": "array",
            "description": "Event detail-types matched by the egress rule and queued for delivery to the external system. Omit for an ingress-only gateway (webhook: true) that only receives from the external system.",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "webhook": {
            "type": "boolean",
            "default": false,
            "description": "Create the optional inbound webhook API (POST /webhook)."
          },
          "jwt": {
            "type": "object",
            "description": "Optional JWT authoriser for the webhook API. Without it the webhook is unauthenticated at the infrastructure layer (the ingress Lambda may still verify signatures itself).",
            "additionalProperties": false,
            "required": [
              "issuer",
              "audiences"
            ],
            "properties": {
              "issuer": {
                "type": "string"
              },
              "audiences": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          },
          "secret_arns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameter_arns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artefacts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ingress": {
                "$ref": "#/$defs/artefact"
              },
              "egress": {
                "$ref": "#/$defs/artefact"
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "egress"
            ]
          },
          {
            "required": [
              "webhook"
            ],
            "properties": {
              "webhook": {
                "const": true
              }
            }
          }
        ]
      }
    },
    "operations": {
      "type": "object",
      "description": "Cross-cutting operational patterns. All enabled by default - disable explicitly.",
      "additionalProperties": false,
      "properties": {
        "event_lake": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "detail_types": {
              "type": "array",
              "description": "Restrict archival to these detail-types. Omit to archive every fact on the hub.",
              "items": {
                "type": "string"
              }
            },
            "bucket_name": {
              "type": "string",
              "description": "Override the globally-unique S3 bucket name. Defaults to <subsystem>-event-lake."
            },
            "retention_days": {
              "type": "integer",
              "minimum": 0
            },
            "object_lock_retention_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "fault_monitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "emails": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "email"
              }
            },
            "bucket_name": {
              "type": "string",
              "description": "Override the globally-unique S3 bucket name. Defaults to <subsystem>-faults."
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "emails": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "email"
              }
            },
            "dashboard": {
              "type": "boolean",
              "default": true
            },
            "adot_layer_arn": {
              "type": "string",
              "description": "ARN of the AWS Distro for OpenTelemetry (ADOT) Lambda layer to attach to every function. Must match the function architecture (arm64). When set, the composer adds the OpenTelemetry exec wrapper; when omitted, functions use X-Ray active tracing only."
            }
          }
        },
        "regional_health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "region": {
              "type": "string",
              "description": "Region the CloudWatch alarms live in, for the Route 53 health checks."
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "description": "Public edge [frontend_edge + micro_frontend]. NOT consumed by modules/composition/subsystem (CloudFront/ACM/Route 53 live in us-east-1 behind a provider alias). Read by a separate us-east-1 edge root that also consumes the composer's api_origins output - see the composer README. Documented here so one manifest fully describes the subsystem.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acm_certificate_arn": {
          "type": "string"
        },
        "micro_frontend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "deployer_artefact": {
              "$ref": "#/$defs/artefact"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artefact": {
      "type": "object",
      "description": "S3 reference to a Lambda deployment package. The library is source-code free - artefacts are published by your CI/CD.",
      "additionalProperties": false,
      "required": [
        "bucket",
        "key"
      ],
      "properties": {
        "bucket": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "bffArtefacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rest": {
          "$ref": "#/$defs/artefact"
        },
        "listener": {
          "$ref": "#/$defs/artefact"
        },
        "trigger": {
          "$ref": "#/$defs/artefact"
        }
      }
    }
  }
}
