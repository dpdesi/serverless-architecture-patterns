import "tfplan/v2" as tfplan

encrypted_types = ["aws_dynamodb_table", "aws_sqs_queue", "aws_cloudwatch_log_group"]

violations = filter tfplan.resource_changes as _, rc {
  rc.type in encrypted_types and
  rc.mode is "managed" and
  rc.change.actions contains "create" and
  rc.change.after is not null
}

main = rule {
  length(violations) >= 0
}
